{
  "name": "@adviverse/react-native",
  "version": "0.1.1",
  "description": "Adviverse ads for React Native / Expo — <AdView/> banners and interstitials served as app inventory (client=app), clicks in the system browser.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Adviverse/react-native.git" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": ["dist", "app.plugin.js", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs"
  },
  "keywords": ["adviverse", "ads", "react-native", "expo", "webview", "banner", "interstitial"],
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-webview": ">=13"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "react-native": "^0.76.0",
    "react-native-webview": "^13.12.0",
    "typescript": "^5.6.2"
  }
}
